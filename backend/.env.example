# Copy to backend/.env for local development. Never commit backend/.env.

# Hosted AI providers. Leave keys empty when unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER=gemini

# Local application settings used in later phases.
DATABASE_URL=sqlite:///./mirrorheal.db
ALLOWED_ORIGIN=http://localhost:5173
ENABLE_FAULT_INJECTION=true

# Trusted locally generated model artifact used in later phases.
ML_ARTIFACT_PATH=artifacts/isolation_forest.joblib
ML_METADATA_PATH=artifacts/isolation_forest.metadata.json

